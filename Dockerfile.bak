# Minimal Dockerfile — installs only backend deps, uses pre-compiled dist
FROM node:20-alpine

RUN apk add --no-cache curl tzdata \
    && cp /usr/share/zoneinfo/Africa/Johannesburg /etc/localtime \
    && echo "Africa/Johannesburg" > /etc/timezone

WORKDIR /app

# Copy root + ALL workspace package.json files (npm needs them for workspace resolution)
COPY package.json ./
COPY src/backend/package.json ./src/backend/package.json
COPY src/frontend/package.json ./src/frontend/package.json

# Install ONLY backend deps via workspace (frontend package.json exists but won't be installed)
RUN npm install --workspace=src/backend --legacy-peer-deps && \
    rm -rf src/frontend

# Copy pre-compiled dist + migrations + entrypoint
COPY src/backend/dist ./src/backend/dist
COPY src/backend/src/database ./src/backend/src/database
COPY entrypoint.sh ./
RUN chmod +x entrypoint.sh

HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:${PORT:-3000}/health || exit 1

EXPOSE 3000

WORKDIR /app/src/backend
ENTRYPOINT ["/app/entrypoint.sh"]
