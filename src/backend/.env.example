# ──────────────────────────────────────────────
# Environment Configuration for Ngome Platform
# ──────────────────────────────────────────────
# Copy this file to .env and fill in your values

# ── JWT Authentication ────────────────────────
JWT_SECRET=change-me-to-a-random-64-char-hex-string
JWT_REFRESH_SECRET=change-me-to-another-random-64-char-hex-string

# ── CORS ──────────────────────────────────────
CORS_ORIGINS=https://ngome-frontend.vercel.app

# ── Node Environment ──────────────────────────
NODE_ENV=development

# ── Database ──────────────────────────────────
DATABASE_URL=sqlite:///data/ngome.sqlite

# ── Redis (optional, for production) ──────────
REDIS_URL=redis://localhost:6379

# ── Server ────────────────────────────────────
PORT=10000

# ── Email (SMTP) ──────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password

# ── Active Directory / LDAP ───────────────────
AD_URL=ldap://ad.example.com
AD_BIND_DN=cn=binduser,dc=example,dc=com
AD_BIND_CREDENTIALS=your-ad-bind-credentials

# ── AWS (for S3 file storage) ─────────────────
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=us-east-1
S3_BUCKET=your-s3-bucket-name
