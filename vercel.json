{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "name": "cut-grc-frontend",
  "framework": "vite",
  "installCommand": "npm install --include=dev --workspace=src/frontend",
  "buildCommand": "npm run build --workspace=src/frontend",
  "outputDirectory": "src/frontend/dist",
  "env": {
    "VITE_API_BASE_URL": "https://cut-grc-backend-production.up.railway.app/api/v1",
    "VITE_APP_ENVIRONMENT": "production",
    "VITE_ENABLE_DEBUG": "false",
    "VITE_ENABLE_MOCK_API": "false"
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/",
      "destination": "/dashboard",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
